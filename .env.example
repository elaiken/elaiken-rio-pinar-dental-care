RESEND_API_KEY=re_your_resend_api_key
# For production, use a verified sender like:
# RESEND_FROM="Rio Pinar Dental Care <appointments@yourdomain.com>"
# During initial testing, Resend may provide a sandbox sender.
RESEND_FROM="Rio Pinar Dental Care <onboarding@resend.dev>"
LEAD_NOTIFICATION_TO=RioPinarDentalCare@gmail.com
# Optional CC list for additional staff notifications
LEAD_NOTIFICATION_CC=
# Optional patient confirmation email settings
PATIENT_CONFIRMATION_FROM="Rio Pinar Dental Care <onboarding@resend.dev>"
PATIENT_CONFIRMATION_REPLY_TO=RioPinarDentalCare@gmail.com
